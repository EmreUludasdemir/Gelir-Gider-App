# ==============================
# FINANCE APP - API CONFIGURATION
# ==============================

# Database (PostgreSQL)
# Development: postgresql://user:password@localhost:5432/dbname
# Docker: postgresql://user:password@postgres:5432/dbname
DATABASE_URL="postgresql://finance_user:finance_secret_2024@localhost:5432/finance_db?schema=public"

# Connection Pool Settings (PgBouncer opsiyonel)
# ?connection_limit=10&pool_timeout=20

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Gemini AI
GEMINI_API_KEY=AIzaSyArJ9GsXwK-QVdbFb9FZu3lc1vbatnybE8

# PDF Parser Service
PDF_PARSER_URL=http://localhost:8001

# Telegram Integration (optional)
TELEGRAM_BOT_TOKEN=

# Bank Connection Encryption (required for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BANK_ENCRYPTION_KEY=

# Push Notifications (optional)
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# Email (SMTP) Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gelir-gider.app

# App URL (for email links)
APP_URL=http://localhost:3000

# Stripe Payment (SaaS Billing)
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App Settings
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=debug
