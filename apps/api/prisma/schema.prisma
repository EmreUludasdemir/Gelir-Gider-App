// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Security fields
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  backupCodes      String? // JSON array of hashed backup codes

  // OAuth fields
  googleId  String? @unique
  githubId  String? @unique
  avatarUrl String?

  // Telegram integration
  telegramChatId String? @unique

  transactions    Transaction[]
  savingsGoals    SavingsGoal[]
  budgets         Budget[]
  preferences     UserPreference?
  creditCards     CreditCard[]
  auditLogs       AuditLog[]
  bankConnections BankConnection[]
}

// Bank Connection for API Integration
model BankConnection {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bankCode      String // 'yapikredi' | 'garanti' | 'isbank' | 'mock'
  bankName      String // Display name
  accountNumber String?
  accountName   String?
  accountType   String  @default("checking") // 'checking' | 'savings' | 'credit'

  // OAuth tokens (encrypted in production)
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?

  // Sync metadata
  lastSyncAt     DateTime?
  lastSyncStatus String? // 'success' | 'failed' | 'pending'
  syncError      String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bankCode, accountNumber])
  @@index([userId])
}

model Transaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId   String   @default("default")
  date        DateTime
  description String
  amount      Float
  currency    String   @default("TRY")
  source      String // 'pdf' | 'manual'
  type        String // 'income' | 'expense'

  categoryId    String
  categoryLabel String
  confidence    Float  @default(100.0)

  tags  String // Stored as JSON string or comma separated
  notes String?

  // Credit card relation
  creditCardId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([date])
  @@index([creditCardId])
}

model SavingsGoal {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  color         String    @default("#8B5CF6")
  icon          String    @default("🎯")
  deadline      DateTime?
  isCompleted   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Budget {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId     String
  categoryLabel  String
  limitAmount    Float
  period         String  @default("monthly") // 'weekly' | 'monthly' | 'yearly'
  alertThreshold Float   @default(80) // Alert when reaching this percentage
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([userId])
}

model UserPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  language String @default("tr") // 'tr' | 'en'
  currency String @default("TRY") // 'TRY' | 'USD' | 'EUR'
  theme    String @default("light") // 'light' | 'dark' | 'system'

  // Notification preferences
  emailNotifications Boolean @default(true)
  budgetAlerts       Boolean @default(true)
  weeklyReport       Boolean @default(false)
  telegramAlerts     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Credit Card tracking
model CreditCard {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  lastFourDigits String
  cardType       String  @default("visa") // 'visa' | 'mastercard' | 'amex' | 'other'
  creditLimit    Float
  currentBalance Float   @default(0)
  billingDay     Int     @default(1) // Day of month for statement
  dueDay         Int     @default(15) // Day of month for payment due
  minPayment     Float   @default(0)
  interestRate   Float   @default(0) // APR percentage
  color          String  @default("#1F2937")
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Audit log for security
model AuditLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    String // 'login' | 'logout' | 'password_change' | 'transaction_create' | etc.
  entity    String? // 'transaction' | 'budget' | 'user' | etc.
  entityId  String?
  details   String? // JSON with additional details
  ipAddress String?
  userAgent String?
  success   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
