{
  "name": "@app/desktop",
  "version": "1.0.0",
  "description": "Gelir-Gider Desktop App",
  "main": "dist/main.js",
  "author": "Emre Uludeşdemir",
  "license": "MIT",
  "scripts": {
    "electron:dev": "tsc && electron .",
    "electron:build": "tsc && electron-builder",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.gelir-gider.app",
    "productName": "Gelir Gider",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "assets/icon.icns"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis", "portable"]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": ["AppImage", "deb"],
      "category": "Office"
    }
  }
}
