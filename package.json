{
  "name": "gelir-gider-app",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @app/web",
    "dev:api": "npm run start:dev -w @app/api",
    "dev:parser": "cd services/pdf-parser && uvicorn app.main:app --reload --port 8001",
    "dev:desktop": "npm run electron:dev -w @app/desktop",
    "build": "npm run build -w @app/api && npm run build -w @app/web",
    "build:desktop": "npm run electron:build -w @app/desktop",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test -w @app/api",
    "test:web": "npm run test -w @app/web",
    "test:cov": "npm run test:cov -w @app/api",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.next apps/*/dist",
    "verify": "bash scripts/verify.sh",
    "db:migrate": "npm run db:migrate -w @app/api",
    "db:seed": "npm run db:seed -w @app/api",
    "db:reset": "npm run db:reset -w @app/api",
    "db:studio": "npm run db:studio -w @app/api",
    "setup": "npm install && npm run db:migrate && npm run db:seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@nestjs/swagger": "^7.4.2"
  }
}
