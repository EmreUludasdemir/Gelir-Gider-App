{
  "name": "gelir-gider-app",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @app/web",
    "dev:api": "npm run start:dev -w @app/api",
    "dev:parser": "cd services/pdf-parser && uvicorn app.main:app --reload --port 8001",
    "dev:desktop": "npm run electron:dev -w @app/desktop",
    "build": "npm run build -w @app/api && npm run build -w @app/web",
    "build:desktop": "npm run electron:build -w @app/desktop",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.next apps/*/dist",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@nestjs/swagger": "^7.4.2"
  }
}
